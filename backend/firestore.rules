rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // ============ ARTICLES ============

    match /articles/{articleId} {

      // Anyone can read published articles
      allow read: if true;

      // Only authenticated users can create articles
      allow create: if isSignedIn()
                    && incomingData().authorUid == request.auth.uid
                    && isValidString(incomingData().title, 200)
                    && isValidString(incomingData().description, 500)
                    && isValidString(incomingData().content, 50000)
                    && isValidString(incomingData().author, 100)
                    && incomingData().urlToImage is string;

      // Only the author can update their own articles
      allow update: if isOwner(existingData().authorUid)
                    && incomingData().authorUid == existingData().authorUid
                    && incomingData().createdAt == existingData().createdAt;

      // Only the author can delete their own articles
      allow delete: if isOwner(existingData().authorUid);
    }
  }
}